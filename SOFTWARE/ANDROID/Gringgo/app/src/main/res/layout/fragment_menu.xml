<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".Menu">

    <!-- =========== LIGNE 1 : 3 CARTES =========== -->

    <!-- CARTE BPM (Haut-Gauche) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_bpm"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_marginEnd="6dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toStartOf="@+id/card_pas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/fond_arrondi_home">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BPM"
                android:textSize="14sp"
                android:textColor="#666666"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/chiffre_bpm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="40sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:fontFamily="@font/atkinson_hyperlegible_bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- CARTE PAS (Haut-Milieu) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_pas"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toStartOf="@+id/card_spo2"
        app:layout_constraintStart_toEndOf="@+id/card_bpm"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/fond_arrondi_home">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pas"
                android:textSize="14sp"
                android:textColor="#666666"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/chiffre_pas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="40sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:fontFamily="@font/atkinson_hyperlegible_bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- CARTE SPO2 (Haut-Droit) - NOUVELLE -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_spo2"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_marginStart="6dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/card_pas"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/fond_arrondi_home">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SpO₂"
                android:textSize="14sp"
                android:textColor="#666666"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/chiffre_spo2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="40sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:fontFamily="@font/atkinson_hyperlegible_bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- =========== LIGNE 2 : 2 CARTES =========== -->

    <!-- CARTE TEMPÉRATURE (Bas-Gauche) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_temp"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toStartOf="@+id/card_battery"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_bpm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/fond_arrondi_home">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Température"
                android:textSize="14sp"
                android:textColor="#666666"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/chiffre_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="40sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:fontFamily="@font/atkinson_hyperlegible_bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- CARTE BATTERIE (Bas-Droit) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_battery"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/card_temp"
        app:layout_constraintTop_toBottomOf="@+id/card_pas">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/fond_arrondi_home">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Batterie"
                android:textSize="14sp"
                android:textColor="#666666"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/chiffre_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="40sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:fontFamily="@font/atkinson_hyperlegible_bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- BOUTON SCAN -->
    <Button
        android:id="@+id/button"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:text="@string/scan_devices"
        app:backgroundTint="#226D68"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_temp" />

</androidx.constraintlayout.widget.ConstraintLayout>